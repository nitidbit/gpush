#!/bin/bash
set -e

REPO="$(cd "$(dirname "$0")/.." && pwd)"
INSTALL_DIR="/opt/homebrew/bin"
BINS=(gpush gpush_get_specs gpush_changed_files)

for bin in "${BINS[@]}"; do
  target="$INSTALL_DIR/$bin"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "error: $target already exists and is not a symlink (brew-managed?)" >&2
    exit 1
  fi
done

echo "Installing dev gpush binaries from $REPO/bin/ -> $INSTALL_DIR/"
for bin in "${BINS[@]}"; do
  ln -sf "$REPO/bin/$bin" "$INSTALL_DIR/$bin"
  echo "  linked $bin"
done
echo "Done."
